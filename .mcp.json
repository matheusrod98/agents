{
  "mcpServers": {
    "aws": {
      "type": "http",
      "url": "https://aws-mcp.us-east-1.api.aws/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp/oauth"
    },
    "drawio": {
      "command": "drawio-mcp",
      "type": "stdio"
    },
    "excalidraw": {
      "type": "http",
      "url": "https://mcp.excalidraw.com/mcp"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "github": {
      "args": ["--toolsets=default,projects"],
      "command": "github-mcp-server",
      "type": "stdio"
    },
    "gitlab": {
      "type": "http",
      "url": "https://gitlab.com/api/v4/mcp"
    },
    "grafana": {
      "command": "mcp-grafana",
      "env": {
        "GRAFANA_URL": "https://grafana-dev.tupifintech.com/"
      },
      "type": "stdio"
    },
    "open-computer-use": {
      "command": "open-computer-use",
      "args": ["mcp"],
      "type": "stdio"
    },
    "kubernetes": {
      "command": "kubernetes-mcp-server",
      "type": "stdio"
    },
    "playwright": {
      "args": ["--browser", "chromium"],
      "command": "playwright-mcp",
      "type": "stdio"
    },
    "todoist": {
      "type": "http",
      "url": "https://ai.todoist.net/mcp"
    }
  }
}
