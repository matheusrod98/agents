{
  "editorMode": "vim",
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/matheus/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "mcpServers": {
    "open-computer-use": {
      "args": ["mcp"],
      "command": "open-computer-use",
      "type": "stdio"
    }
  },
  "permissions": {
    "defaultMode": "auto"
  }
}
