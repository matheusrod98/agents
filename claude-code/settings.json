{
  "editorMode": "vim",
  "enabledPlugins": {
    "atlassian@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "env": {
    "GIT_EDITOR": "true",
    "GIT_SEQUENCE_EDITOR": "true",
    "GIT_MERGE_AUTOEDIT": "no"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node /home/matheus/.agents/claude-code/git-guard.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/matheus/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "mcpServers": {
    "open-computer-use": {
      "args": ["mcp"],
      "command": "open-computer-use",
      "type": "stdio"
    }
  },
  "permissions": {
    "defaultMode": "auto"
  }
}
